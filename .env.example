# ============================================
# 复制本文件为 .env 后按需修改（.env 已被 gitignore，不会提交）
# 不创建 .env 也能跑：docker-compose.yml 内已内置本地演示默认值
# ============================================

# MySQL root 密码（仅容器内使用，宿主机本地 MySQL 不受影响）
MYSQL_ROOT_PASSWORD=root123456

# 应用连接 MySQL 的业务账号（由 mysql 镜像自动创建并授予 hr_security 库全部权限）
MYSQL_USER=hr
MYSQL_PASSWORD=hr123456

# JWT 签名密钥：至少 32 字节。生产生成方式：openssl rand -base64 48
# JWT_SECRET=请用随机长字符串替换
