# ============================================
# 复制本文件为 .env 后按需修改（.env 已被 gitignore，不会提交）
# 不创建 .env 也能跑：docker-compose.yml 内已内置本地演示默认值
# ============================================

# MySQL root 密码（仅容器内使用，宿主机本地 MySQL 不受影响）
MYSQL_ROOT_PASSWORD=root123456

# 应用连接 MySQL 的业务账号（由 mysql 镜像自动创建并授予 hr_security 库全部权限）
MYSQL_USER=hr
MYSQL_PASSWORD=hr123456

# JWT 签名密钥：至少 32 字节。生产生成方式：openssl rand -base64 48
# JWT_SECRET=请用随机长字符串替换

# KEK（密钥加密密钥，第 7 周起）：必须是 32 字节的 Base64，生成：openssl rand -base64 32
# 语义：它只用于**信封加密 DEK**（sys_data_key.encrypted_dek），不直接加密业务字段；
#       真正的数据密钥（DEK）落库、可轮换，见 docs/key-management.md。
# 红线：KEK 绝不入库、绝不进 git；换掉它会直接启动失败（DEK 是用旧 KEK 包的），需先重新封装 DEK。
# AES_MASTER_KEY=请用随机 32 字节密钥的 Base64 替换

# KEK 版本号（写进 DEK 密文头部 v1:{kekId}:{iv}:{ct}，用于识别"DEK 是哪把 KEK 包的"）
# AES_KEK_ID=kek1

# 首次引导时生成的 DEK 版本号（仅当 sys_data_key 为空时使用；之后由表里 ACTIVE 的那把决定）
# AES_KEY_ID=k1

# 身份证检索哈希（HMAC-SHA256）的盐：留空则由 KEK 域分隔派生（轮换 DEK 不影响哈希列）
# ID_HASH_SALT=
